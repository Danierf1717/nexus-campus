# Plantilla de ejemplo. No contiene credenciales reales.
# Se ajustará al crear la configuración de Django y PostgreSQL.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=nexus_campus
DB_USER=nexus_user
DB_PASSWORD=change-this-local-password
DB_HOST=localhost
DB_PORT=5432
